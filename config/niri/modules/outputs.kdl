output "eDP-1" {
  // off
  mode "1920x1080"
  scale 1
  transform "normal"

  hot-corners {
    off
  }
}

output "DP-2" {
  // off
  mode "2560x1440"
  scale 1
  transform "normal"
  position x=-2560 y=0

  hot-corners {
    off
  }
}

output "DP-3" {
  // off
  mode "1920x1080@60"
  scale 1
  transform "normal"
  position x=-1920 y=0

  hot-corners {
    off
  }
}
