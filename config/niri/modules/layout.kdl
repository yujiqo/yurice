overview {
  workspace-shadow {
    off
  }
}

layout {
  gaps 10
  background-color "transparent"

  center-focused-column "never"
  always-center-single-column
  empty-workspace-above-first

  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }

  default-column-width { proportion 0.5; }

  focus-ring {
    off
    width 3

    // active-color "#ff6363"
    // inactive-color "#8563ff"

    active-gradient from="#ff6363" to="#8563ff" angle=45
    // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
  }

  border {
    // off
    width 3

    // active-color "#ff6363"
    inactive-color "#a8a8a8"
    urgent-color "#9b0000"

    active-gradient from="#ff6363" to="#8563ff" angle=45
  }

  shadow {
    // on
    // draw-behind-window true
    softness 30
    spread 5
    offset x=0 y=5
    color "#0007"
  }

  struts {
    // left 64
    // right 64
    // top 64
    // bottom 64
  }
}
